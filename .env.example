# Configurar únicamente como secretos del servidor, nunca en el código del navegador.
# ADMIN_EMAIL identifica a la propietaria para configurar o recuperar la contraseña.
# No concede por sí solo acceso al panel.
ADMIN_EMAIL=
ADMIN_DNI=
# Microsoft Graph: autorización delegada Files.ReadWrite y offline_access.
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
MS_DRIVE_ID=
MS_WORKBOOK_ID=
